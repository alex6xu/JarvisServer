# JarvisServer backup paths. Copy to /etc/jarvis/backup.env and adjust.
JARVIS_INSTALL_DIR=/opt/jarvis
JARVIS_DATABASE_PATH=/var/lib/jarvis/data/gateway.db
JARVIS_DOCUMENTS_DIR=/var/lib/jarvis/documents
JARVIS_WORKSPACES_DIR=/var/lib/jarvis/workspaces
JARVIS_RUNTIME_DIR=/var/lib/jarvis
JARVIS_HOME_DIR=/var/lib/jarvis/home
JARVIS_SKILLS_DIR=/var/lib/jarvis/skills
JARVIS_CONFIG_FILE=/etc/jarvis/gateway.yaml
# Optional service environment/secrets file; omitted when absent.
JARVIS_ENV_FILE=/etc/jarvis/gateway.env
JARVIS_BACKUP_DIR=/var/backups/jarvis
JARVIS_BACKUP_RETENTION_DAYS=14
JARVIS_BACKUP_RETENTION_COUNT=7
JARVIS_BACKUP_MIN_FREE_KB=524288
