[Unit]
Description=Jarvis Gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=jarvis
Group=jarvis
WorkingDirectory=/var/lib/jarvis
# 管理员初始密码用环境变量注入，避免写进配置文件
Environment=JARVIS_HOME=/var/lib/jarvis/home
Environment=JARVIS_SKILLS_DIR=/var/lib/jarvis/skills
Environment=JARVIS_ADMIN_PASSWORD=__REPLACE_WITH_LONG_RANDOM_PASSWORD__
# 可选：启用 Reddit / X / Polymarket 美股舆情。
# Environment=SOCIAL_SENTIMENT_API_KEY=__REPLACE_WITH_SENTIMENT_API_KEY__
# 可选：至少配置一个新闻舆情 Provider。
# Environment=ANSPIRE_API_KEYS=__REPLACE_WITH_ANSPIRE_API_KEY__
# Environment=TAVILY_API_KEY=__REPLACE_WITH_TAVILY_API_KEY__
# Environment=BOCHA_API_KEYS=__REPLACE_WITH_BOCHA_API_KEY__
# Environment=BRAVE_API_KEY=__REPLACE_WITH_BRAVE_API_KEY__
ExecStart=/opt/jarvis/bin/gateway -f /etc/jarvis/gateway.yaml
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
UMask=0077

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/jarvis

[Install]
WantedBy=multi-user.target
