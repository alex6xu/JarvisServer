[Unit]
Description=Back up JarvisServer database and file data
After=local-fs.target

[Service]
Type=oneshot
User=jarvis
Group=jarvis
EnvironmentFile=-/etc/jarvis/backup.env
ExecStart=/opt/jarvis/bin/backup-data
UMask=0077
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/var/lib/jarvis /etc/jarvis
ReadWritePaths=/var/backups/jarvis
